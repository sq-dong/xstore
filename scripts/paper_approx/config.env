# Defaults for paper_approx sweeps. Override before sourcing if needed.
#   set -a; source config.env; set +a

# Repo root (scripts/paper_approx -> ../..)
XSTORE_ROOT=${XSTORE_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}

SERVER_HOST_IB=${SERVER_HOST_IB:-10.10.1.16}
SERVER_PORT=${SERVER_PORT:-8888}
CLIENT_HOST=${CLIENT_HOST:-bfhost_72}

NKEYS=${NKEYS:-1000000}
NMODELS=${NMODELS:-1000}
VAL_LEN=${VAL_LEN:-8}
LOAD_FROM_FILE=${LOAD_FROM_FILE:-false}
VLEN=${VLEN:-false}

SERVER_THREADS=${SERVER_THREADS:-16}
SERVER_ALLOC_MEM_M=${SERVER_ALLOC_MEM_M:-16384}
SERVER_LIFE_S=${SERVER_LIFE_S:-3600}
SERVER_NIC_IDX=${SERVER_NIC_IDX:-0}

# Fig.12a load ladder: threads:coros:nclients
# Keep threads_per_client <= 12 if mlx5_1 is down (client maps t>=12 to nic 1).
THREADS_PER_CLIENT=${THREADS_PER_CLIENT:-1}
COROS=${COROS:-4}
NCLIENTS_LIST=${NCLIENTS_LIST:-1,2,4,6,8}
FIG12_LOAD_LIST=${FIG12_LOAD_LIST:-1:1:1,1:4:1,1:4:4,1:8:8,1:16:12,1:16:24,1:16:32,1:32:32,1:32:48,8:10:8,8:16:12,12:10:12}

CPU_BASE=${CPU_BASE:-0}
CPU_STRIDE=${CPU_STRIDE:-1}
CLIENT_WARMUP_S=${CLIENT_WARMUP_S:-5}
REPORT_EPOCHS=${REPORT_EPOCHS:-20}
CLIENT_EXTRA_WAIT_S=${CLIENT_EXTRA_WAIT_S:-40}
CLIENT_STAGGER_S=${CLIENT_STAGGER_S:-0.3}
TRIM_HEAD=${TRIM_HEAD:-5}
TRIM_TAIL=${TRIM_TAIL:-5}

# Fig.15: nmodels sweep (peak vs low load)
FIG15_NMODELS_LIST=${FIG15_NMODELS_LIST:-500,1000,2000,5000,10000}
FIG15_PEAK_LOAD=${FIG15_PEAK_LOAD:-1:16:32}
FIG15_LOW_LOAD=${FIG15_LOW_LOAD:-1:1:1}
FIG15_NCLIENTS=${FIG15_NCLIENTS:-32}

# Fig.15-dist: OSM file keys (data_server / data_client, USE_NN=0)
DATA_FILE=${DATA_FILE:-deps/kvs-workload/dataset/osm_uni_10m.txt}
FIG15_DIST_NKEYS=${FIG15_DIST_NKEYS:-1000000}
FIG15_DIST_DATA_FILE=${FIG15_DIST_DATA_FILE:-deps/kvs-workload/dataset/osm_uni_10m.txt}
FIG15_DIST_NMODELS_LIST=${FIG15_DIST_NMODELS_LIST:-500,1000,2000,5000,10000}

# Fig.16a: value sizes at peak load
FIG16_LEN_LIST=${FIG16_LEN_LIST:-16,32,64,128,256,512,1024}
FIG16_NCLIENTS=${FIG16_NCLIENTS:-32}
FIG16_LOAD=${FIG16_LOAD:-1:16:32}

export LD_LIBRARY_PATH="${XSTORE_ROOT}/deps/boost/lib:${XSTORE_ROOT}/deps/mkl/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export MKL_THREADING_LAYER=SEQUENTIAL
